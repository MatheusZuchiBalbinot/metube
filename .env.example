# ─────────────────────────────────────────────────────────────────────────────
# ROOT .env — docker-compose port overrides
# These are only used by docker-compose.yml to expose host ports.
# They do NOT affect the application itself (use backend/.env for that).
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000     # host port → backend container (Octane/FrankenPHP)
FRONTEND_PORT=5173    # host port → frontend container (Vite dev server)
POSTGRES_PORT=5432    # host port → postgres container
