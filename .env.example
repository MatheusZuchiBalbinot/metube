# ─────────────────────────────────────────────────────────────────────────────
# ROOT .env — docker-compose port overrides (dev only)
# These are only used by docker-compose.yml to expose host ports.
# They do NOT affect the application itself (use backend/.env for that).
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000     # host port → backend container (Octane/FrankenPHP)
FRONTEND_PORT=5173    # host port → frontend container (Vite dev server)
POSTGRES_PORT=5432    # host port → postgres container

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ONLY — frontend build args (docker-compose.prod.yml)
# Required when running: docker compose -f docker-compose.yml -f docker-compose.prod.yml up
# These are baked into the JS bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────
VITE_REVERB_APP_KEY=          # must match REVERB_APP_KEY in backend/.env
VITE_REVERB_HOST=             # public domain, e.g. metubeapp.com
VITE_REVERB_PORT=443          # 443 with HTTPS (default), 80 without
VITE_REVERB_SCHEME=https      # https in production, http in dev
