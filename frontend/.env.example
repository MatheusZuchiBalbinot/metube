# Copy to .env for local development.
#
# Browser-side Reverb client. VITE_REVERB_APP_KEY must match REVERB_APP_KEY in
# backend/.env — without it getEcho() returns null and realtime notifications
# are silently disabled. The websocket goes through the Vite dev server, which
# proxies /app to ws://reverb:8080 (see vite.config.ts), so the host and port
# below are Vite's, not Reverb's.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=5173
VITE_REVERB_SCHEME=http
