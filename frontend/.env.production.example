# Production build defaults for the browser-side Reverb client.
# These are overridden by the build args in docker-compose.prod.yml (sourced
# from the repo-root .env), so keep them consistent with an HTTPS deployment:
# the websocket is reached over wss:// through caddy on :443.
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
