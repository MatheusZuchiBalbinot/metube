# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="MeTube"
APP_ENV=local                   # local | production
APP_KEY=
APP_DEBUG=true                  # set to false in production
APP_URL="http://localhost"

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL — service name "postgres" in docker-compose)
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres                # docker service name; use "127.0.0.1" outside Docker
DB_PORT=5432
DB_DATABASE=metube
DB_USERNAME=postgres
DB_PASSWORD=postgres            # must match POSTGRES_PASSWORD in .env.postgres

# ─────────────────────────────────────────────────────────────────────────────
# SESSION (used by Sanctum for stateful/cookie-based auth)
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis            # redis is required; sessions are stored in Redis
SESSION_LIFETIME=120            # session TTL in minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null             # set to your domain in production (e.g. example.com)
SESSION_SECURE_COOKIE=false     # set to true in production (requires HTTPS)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ─────────────────────────────────────────────────────────────────────────────
# SANCTUM (cookie/session auth for the SPA)
# Domains listed here are allowed to make stateful requests (sets session cookie).
# Add every host:port the frontend runs on.
# ─────────────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND
# Used by the backend to set CORS allowed origins and cookie domain.
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# QUEUE & CACHE
# ─────────────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis               # use redis queue driver
CACHE_STORE=redis               # Redis is used for caching
TRANSCRIPTION_MAX_PROCESSES=1        # max Horizon workers for the transcription queue (keep at 1 to avoid OOM)

# ─────────────────────────────────────────────────────────────────────────────
# CACHE — TTLs and enable/disable per group
# ─────────────────────────────────────────────────────────────────────────────
CACHE_FEED_TTL=60
CACHE_FEED_ACTIVE=true
CACHE_CHANNEL_INFO_TTL=600
CACHE_CHANNEL_INFO_ACTIVE=true
CACHE_CHANNEL_VIDEOS_TTL=120
CACHE_CHANNEL_VIDEOS_ACTIVE=true
CACHE_VIDEO_META_TTL=300
CACHE_VIDEO_META_ACTIVE=true
CACHE_VIDEO_SUMMARY_ACTIVE=true
CACHE_USER_PLAYLISTS_TTL=300
CACHE_USER_PLAYLISTS_ACTIVE=true
CACHE_USER_SUBSCRIPTIONS_TTL=300
CACHE_USER_SUBSCRIPTIONS_ACTIVE=true
CACHE_USER_HISTORY_EVENTS_TTL=300
CACHE_USER_HISTORY_EVENTS_ACTIVE=true
CACHE_RECOMMENDATIONS_TTL=300
CACHE_RECOMMENDATIONS_ACTIVE=true

# ─────────────────────────────────────────────────────────────────────────────
# REDIS (service name "redis" in docker-compose)
# Used for sessions and cache.
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_HOST=redis                # docker service name; use "127.0.0.1" outside Docker
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis           # requires the ext-redis PHP extension

# ─────────────────────────────────────────────────────────────────────────────
# MAIL (set to "log" in dev — emails are written to storage/logs/laravel.log)
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# OCTANE (HTTP server)
# frankenphp is the server that runs Octane inside the Docker container.
# ─────────────────────────────────────────────────────────────────────────────
OCTANE_SERVER=frankenphp

# ─────────────────────────────────────────────────────────────────────────────
# BROADCASTING — Laravel Reverb (WebSocket server)
# ─────────────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb          # Docker service name — server-to-server (queue/backend → reverb)
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser-side Reverb (Vite injects these as import.meta.env.VITE_*)
# VITE_REVERB_HOST must be the public host the browser reaches — localhost in dev,
# going through the Vite proxy on port 5173 (or nginx in prod).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=5173
VITE_REVERB_SCHEME=http

# ─────────────────────────────────────────────────────────────────────────────
# VIDEO PROCESSING
# All values are read by config/metube.php → video.*
# ─────────────────────────────────────────────────────────────────────────────
VIDEO_MAX_DURATION=120          # max video duration in minutes

# ─────────────────────────────────────────────────────────────────────────────
# THUMBNAIL PROCESSING
# All values are read by config/media.php → thumbnail.*
# ─────────────────────────────────────────────────────────────────────────────
THUMBNAIL_MAX_WIDTH=1280        # max output width in pixels
THUMBNAIL_MAX_HEIGHT=720        # max output height in pixels
THUMBNAIL_QUALITY=80            # WebP quality (0–100)

# ─────────────────────────────────────────────────────────────────────────────
# HLS (native video streaming — TranscodeVideoToHls job, requires ffmpeg)
# Uploaded videos are segmented into an HLS package (master.m3u8 + segments);
# the source file is removed afterwards and HLS becomes the only delivery format.
# ─────────────────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg              # ffmpeg binary (in PATH inside the container)
FFPROBE_PATH=ffprobe            # ffprobe binary (ships with ffmpeg)
HLS_SEGMENT_DURATION=6          # target segment length in seconds
HLS_AUDIO_BITRATE=128k          # AAC bitrate when re-encoding audio
HLS_PROCESS_TIMEOUT=3600        # max seconds a single ffmpeg/ffprobe call may run

# ─────────────────────────────────────────────────────────────────────────────
# WHISPER (transcription service)
# The whisper container reads its own env vars directly (see docker-compose.yml).
# Only WHISPER_URL is consumed by the Laravel backend.
# ─────────────────────────────────────────────────────────────────────────────
WHISPER_URL=http://whisper:8001 # internal service URL; use http://localhost:8001 outside Docker

# ─────────────────────────────────────────────────────────────────────────────
# AI provider — used by GenerateAiMetadata job (Groq by default, OpenAI-compatible)
# ─────────────────────────────────────────────────────────────────────────────
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_URL=https://api.groq.com/openai/v1

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING — New Relic APM
# Leave NEW_RELIC_LICENSE_KEY empty to disable the agent (local dev).
# Obtain your license key at: https://one.newrelic.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=MeTube
