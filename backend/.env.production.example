# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION backend env template.
#
# Copy to backend/.env on the server and fill every <REPLACE_*> placeholder.
# Differences from .env.example are PRODUCTION-CRITICAL — do not ship the dev
# defaults. Replace YOUR_DOMAIN with the real hostname everywhere it appears.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="MeTube"
APP_ENV=production
# Generate with: docker compose exec backend php artisan key:generate --show
APP_KEY=<REPLACE_WITH_GENERATED_KEY>
APP_DEBUG=false
APP_URL="https://YOUR_DOMAIN"

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL — service name "postgres" in docker-compose)
# DB_PASSWORD must match POSTGRES_PASSWORD in .env.postgres — use a strong value.
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=metube
DB_USERNAME=postgres
DB_PASSWORD=<REPLACE_WITH_STRONG_DB_PASSWORD>

# ─────────────────────────────────────────────────────────────────────────────
# SESSION (Sanctum stateful/cookie auth) — secured for HTTPS.
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=YOUR_DOMAIN
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ─────────────────────────────────────────────────────────────────────────────
# SANCTUM — only the production host may open a stateful session.
# ─────────────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=YOUR_DOMAIN

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (CORS allowed origin + cookie domain)
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://YOUR_DOMAIN

# ─────────────────────────────────────────────────────────────────────────────
# FILESYSTEM — disks used by StorageService.
# Set either to "s3" (+ AWS_* below) to use object storage — no code change.
# Note: publicPath()/tempPath() (ffmpeg/HLS) need a local-driver disk.
# ─────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
FILESYSTEM_DISK_PUBLIC=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────────────────────────────────────
# QUEUE & CACHE
# ─────────────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3900
CACHE_STORE=redis
TRANSCRIPTION_MAX_PROCESSES=1

# ─────────────────────────────────────────────────────────────────────────────
# CACHE — TTLs and enable/disable per group
# ─────────────────────────────────────────────────────────────────────────────
CACHE_FEED_TTL=60
CACHE_FEED_ACTIVE=true
CACHE_CHANNEL_INFO_TTL=600
CACHE_CHANNEL_INFO_ACTIVE=true
CACHE_CHANNEL_VIDEOS_TTL=120
CACHE_CHANNEL_VIDEOS_ACTIVE=true
CACHE_VIDEO_META_TTL=300
CACHE_VIDEO_META_ACTIVE=true
CACHE_VIDEO_SUMMARY_ACTIVE=true
CACHE_USER_PLAYLISTS_TTL=300
CACHE_USER_PLAYLISTS_ACTIVE=true
CACHE_USER_SUBSCRIPTIONS_TTL=300
CACHE_USER_SUBSCRIPTIONS_ACTIVE=true
CACHE_USER_HISTORY_EVENTS_TTL=300
CACHE_USER_HISTORY_EVENTS_ACTIVE=true
CACHE_RECOMMENDATIONS_TTL=300
CACHE_RECOMMENDATIONS_ACTIVE=true

# ─────────────────────────────────────────────────────────────────────────────
# REDIS (service name "redis" in docker-compose)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

# ─────────────────────────────────────────────────────────────────────────────
# MAIL — "log" only writes to the container log. Point this at a real SMTP/API
# provider before relying on transactional email in production.
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@YOUR_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# OCTANE
# ─────────────────────────────────────────────────────────────────────────────
OCTANE_SERVER=frankenphp

# ─────────────────────────────────────────────────────────────────────────────
# BROADCASTING — Laravel Reverb (WebSocket server)
# Generate secrets with: php artisan reverb:install (or any random strings).
# REVERB_HOST/PORT/SCHEME below are the INTERNAL server-to-server address and
# stay as the docker service name — they are NOT the public host.
# ─────────────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=<REPLACE_WITH_RANDOM_ID>
REVERB_APP_KEY=<REPLACE_WITH_RANDOM_KEY>
REVERB_APP_SECRET=<REPLACE_WITH_RANDOM_SECRET>
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser-side Reverb — the public host, reached over wss:// through caddy :443.
# VITE_REVERB_APP_KEY must match REVERB_APP_KEY above.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=YOUR_DOMAIN
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ─────────────────────────────────────────────────────────────────────────────
# VIDEO PROCESSING
# ─────────────────────────────────────────────────────────────────────────────
VIDEO_MAX_DURATION=120

# ─────────────────────────────────────────────────────────────────────────────
# THUMBNAIL PROCESSING
# ─────────────────────────────────────────────────────────────────────────────
THUMBNAIL_MAX_WIDTH=1280
THUMBNAIL_MAX_HEIGHT=720
THUMBNAIL_QUALITY=80

# ─────────────────────────────────────────────────────────────────────────────
# HLS (native video streaming — requires ffmpeg)
# ─────────────────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HLS_SEGMENT_DURATION=6
HLS_AUDIO_BITRATE=128k
HLS_PROCESS_TIMEOUT=3600

# ─────────────────────────────────────────────────────────────────────────────
# WHISPER (transcription service)
#   local container → COMPOSE_PROFILES=whisper (repo-root .env)
#   hosted API      → set WHISPER_URL below + leave COMPOSE_PROFILES empty
# ─────────────────────────────────────────────────────────────────────────────
WHISPER_URL=http://whisper:8001

# ─────────────────────────────────────────────────────────────────────────────
# AI provider — used by GenerateAiMetadata job (Groq by default, OpenAI-compatible)
# ─────────────────────────────────────────────────────────────────────────────
AI_API_KEY=<REPLACE_WITH_AI_API_KEY>
AI_MODEL=llama-3.3-70b-versatile
AI_URL=https://api.groq.com/openai/v1

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING — OpenTelemetry → New Relic (optional)
# Leave OTEL_EXPORTER_OTLP_HEADERS empty to disable sending.
# ─────────────────────────────────────────────────────────────────────────────
OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_SERVICE_NAME=MeTube
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4318
OTEL_EXPORTER_OTLP_HEADERS=api-key=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext,baggage
