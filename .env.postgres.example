# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL container environment
# These are passed directly to the postgres:16 Docker image.
# DB_USERNAME and DB_PASSWORD in backend/.env must match these values.
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=vidsum
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
